@model CyberSecurityApp.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit user";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Edit user</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Back to admin panel
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="EditUser" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Login</label>
                    <input asp-for="UserName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Redaktor">Redaktor</option>
                        <option value="Czytelnik">Czytelnik</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save changes
                </button>

                <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
