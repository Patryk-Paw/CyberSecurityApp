@model CyberSecurityApp.ViewModels.SecuritySettingsViewModel

@{
    ViewData["Title"] = "Ustawienia bezpieczeństwa";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Ustawienia bezpieczeństwa</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Powrót do panelu administratora
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <form asp-controller="SecuritySettings" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card mb-4">
            <div class="card-header">
                Polityka haseł
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="MinimumPasswordLength" class="form-label">
                        Minimalna długość hasła
                    </label>
                    <input asp-for="MinimumPasswordLength" class="form-control" type="number" min="15" max="128" />
                    <span asp-validation-for="MinimumPasswordLength" class="text-danger"></span>
                    <div class="form-text">Dozwolony zakres: 15–128 znaków.</div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="EnforceSequencePolicy" class="form-check-input" />
                    <label asp-for="EnforceSequencePolicy" class="form-check-label">
                        Blokuj sekwencje klawiaturowe i rosnące ciągi
                    </label>
                    <div class="form-text">
                        Blokuje między innymi ciągi takie jak qwer, asdf i 1234.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordExpirationDays" class="form-label">
                        Ważność hasła użytkownika (dni)
                    </label>
                    <input asp-for="PasswordExpirationDays" class="form-control" type="number" min="1" max="3650" />
                    <span asp-validation-for="PasswordExpirationDays" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                Sesje i hasła jednorazowe
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="SessionIdleTimeoutMinutes" class="form-label">
                        Czas bezczynności sesji (minuty)
                    </label>
                    <input asp-for="SessionIdleTimeoutMinutes" class="form-control" type="number" min="1" max="1440" />
                    <span asp-validation-for="SessionIdleTimeoutMinutes" class="text-danger"></span>
                    <div class="form-text">
                        Po takim czasie bezczynności użytkownik powinien zostać wylogowany.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="OneTimePasswordValidityHours" class="form-label">
                        Ważność hasła jednorazowego (godziny)
                    </label>
                    <input asp-for="OneTimePasswordValidityHours" class="form-control" type="number" min="1" max="168" />
                    <span asp-validation-for="OneTimePasswordValidityHours" class="text-danger"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            Zapisz ustawienia
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
