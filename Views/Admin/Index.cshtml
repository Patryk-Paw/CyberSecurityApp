@model List<CyberSecurityApp.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Lista użytkowników";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">Użytkownicy</h1>
            <p class="text-secondary mb-0">
                Zarządzanie kontami i uprawnieniami użytkowników.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="SecuritySettings"
               asp-action="Index"
               class="btn btn-outline-primary">
                Ustawienia bezpieczeństwa
            </a>

            <a asp-controller="Admin"
               asp-action="CreateUser"
               class="btn btn-success">
                Generuj użytkownika
            </a>

            <a asp-controller="PasswordDictionary"
               asp-action="Index"
               class="btn btn-primary">
                Słownik haseł
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Powrót
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["GeneratedUserName"] != null &&
        TempData["GeneratedPassword"] != null)
    {
        <div class="alert alert-info" role="alert">
            <h2 class="h5">Dane nowego użytkownika</h2>

            <p class="mb-1">
                <strong>Login:</strong>
                <code>@TempData["GeneratedUserName"]</code>
            </p>

            <p class="mb-1">
                <strong>Hasło jednorazowe:</strong>
                <code>@TempData["GeneratedPassword"]</code>
            </p>

            <p class="mb-0">
                <strong>Ważne do:</strong>
                @TempData["PasswordExpiresAt"]
            </p>

            <hr />

            <p class="mb-0">
                Przekaż te dane użytkownikowi bezpiecznym kanałem.
                Hasło będzie wymagało zmiany przy pierwszym logowaniu.
            </p>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Lista kont</h2>
                <span class="badge text-bg-secondary">
                    Liczba użytkowników: @Model.Count
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="p-4 text-center text-secondary">
                    Brak użytkowników do wyświetlenia.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Login</th>
                                <th>Rola</th>
                                <th>Status konta</th>
                                <th>Hasło</th>
                                <th>Utworzono</th>
                                <th>Ostatnia zmiana hasła</th>
                                <th class="text-end">Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @user.UserName
                                    </td>
                                    <td>
                                        @user.Role
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success text-white">Aktywne</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white">Zablokowane</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.MustChangePassword)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Wymagana zmiana
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">
                                                Ustawione
                                            </span>
                                        }
                                </td>
                                <td>
                                    @user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    @(user.PasswordChangedAt.HasValue
                                                                    ? user.PasswordChangedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                                    : "Brak danych")
                            </td>
                            <td class="text-end text-nowrap">
                                @if (user.Role != "Administrator")
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="EditUser"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-primary">
                                                Edytuj
                                            </a>
                                        }

                                        <form asp-controller="Admin"
                                              asp-action="ToggleUserStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@user.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")"
                                                    onclick="return confirm('@(user.IsActive ? "Czy na pewno chcesz zablokować to konto?" : "Czy na pewno chcesz odblokować to konto?")');">

                                                @(user.IsActive ? "Zablokuj" : "Odblokuj")
                                            </button>
                                        </form>

                                        @if (user.Role != "Administrator")
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="DeleteUser"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-danger">
                                                Usuń
                                            </a>
                                        }
                                    </td>
                        </tr>
                            }          
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>